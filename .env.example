# Configurações para desenvolvimento dos Microserviços

## URLs dos Serviços (Desenvolvimento Local)

# API Gateway
API_GATEWAY_URL=http://localhost:5000
API_GATEWAY_URL_HTTPS=https://localhost:7000

# Chef Service
CHEF_SERVICE_URL=http://localhost:5001
CHEF_SERVICE_URL_HTTPS=https://localhost:7001

# Garcom Service
GARCOM_SERVICE_URL=http://localhost:5002
GARCOM_SERVICE_URL_HTTPS=https://localhost:7002

## Conexões de Banco de Dados

# Chef Service
CHEF_CONNECTION=Server=localhost;Database=SolutionKitchen_Chef;Trusted_Connection=true;Encrypt=false;

# Garcom Service
GARCOM_CONNECTION=Server=localhost;Database=SolutionKitchen_Garcom;Trusted_Connection=true;Encrypt=false;

## Variáveis de Ambiente

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
